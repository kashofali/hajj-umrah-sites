---
import type { LoadedClient as Client } from '../lib/client';
import { initial } from '../lib/client';

interface Props {
  client: Client;
  light?: boolean;
}
const { client, light = false } = Astro.props;
const brand = client.brand!;
---

<span class="flex items-center gap-3">
  {
    client.logo ? (
      <img src={client.logo} alt="" class="h-11 w-11 rounded-xl object-cover" />
    ) : (
      <span
        class:list={[
          'relative flex h-11 w-11 shrink-0 items-center justify-center rounded-xl',
          light ? 'border border-gold/40 bg-brand-900' : 'bg-brand-900 shadow-soft',
        ]}
      >
        <svg viewBox="0 0 44 44" class="absolute inset-0 h-full w-full" aria-hidden="true">
          <path d="M13 36V20a9 9 0 0 1 18 0v16" fill="none" stroke="var(--gold-light)" stroke-width="1.2"></path>
          <circle cx="22" cy="9" r="1.2" fill="var(--gold-light)"></circle>
        </svg>
        <span class="relative mt-2 font-serif text-[15px] font-semibold text-gold-pale">{initial(brand.main)}</span>
      </span>
    )
  }
  <span class="min-w-0 leading-none">
    <span class:list={['block truncate font-serif text-[22px] font-semibold sm:text-2xl', light ? 'text-white' : 'text-brand-900']}>
      {brand.main}
    </span>
    {
      brand.sub && (
        <span class="mt-1.5 block truncate text-[10px] font-bold tracking-[0.28em] text-gold uppercase">{brand.sub}</span>
      )
    }
  </span>
</span>
