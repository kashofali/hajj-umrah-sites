---
import type { LoadedClient, Pkg } from '../lib/client';
import { CATEGORIES, hasAmount, waHref } from '../lib/client';
import Icon from './Icon.astro';

interface Props {
  client: LoadedClient;
  pkg: Pkg;
}
const { client, pkg: p } = Astro.props;
const wa = waHref(client, `Assalamu Alaikum, I'm interested in the ${p.name} package${p.date ? ` (${p.date})` : ''}.`);
const detail = `/packages/${p.slug}`;
---

<article
  class="card flex flex-col overflow-hidden transition duration-300 hover:-translate-y-1 hover:shadow-big"
  data-category={p.category}
>
  <a href={detail} class="group relative block h-[220px] overflow-hidden bg-brand-900" tabindex="-1" aria-hidden="true">
    <img
      src={p.image}
      alt=""
      loading="lazy"
      decoding="async"
      class="absolute inset-0 h-full w-full object-cover transition duration-700 group-hover:scale-105"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-brand-975/55 via-brand-975/10 to-brand-975/80"></div>
    <span
      class="absolute top-4 left-4 rounded-full border border-white/30 bg-black/25 px-3.5 backdrop-blur-sm py-1.5 text-[11px] font-bold tracking-[0.14em] text-white/90 uppercase"
    >
      {p.type ?? CATEGORIES[p.category]}
    </span>
    {
      p.badge && (
        <span
          class:list={[
            'absolute top-4 right-4 flex items-center gap-1.5 rounded-full px-3.5 py-1.5 text-[11px] font-bold tracking-[0.12em] uppercase',
            p.badgeTone === 'accent' ? 'bg-accent text-white' : 'bg-gold-grad text-brand-950',
          ]}
        >
          <Icon name="star" class="h-3 w-3" />
          {p.badge}
        </span>
      )
    }
    {
      p.days && (
        <div class="absolute right-5 bottom-4 text-center text-white">
          <p class="font-serif text-[40px] leading-none">{p.days}</p>
          <p class="mt-1 text-[10px] font-bold tracking-[0.2em] text-gold-light uppercase">Days</p>
        </div>
      )
    }
  </a>

  <div class="flex grow flex-col p-7">
    {
      p.date && (
        <p class="flex items-center gap-2 text-[13px] font-bold tracking-[0.1em] text-accent uppercase">
          <Icon name="calendar" class="h-4 w-4 shrink-0" />
          {p.date}
        </p>
      )
    }
    <h3 class="mt-3 font-serif text-[28px] leading-tight font-semibold text-brand-900">
      <a href={detail} class="hover:text-gold">{p.name}</a>
    </h3>
    {p.description && <p class="mt-3 leading-relaxed text-muted">{p.description}</p>}

    {
      (p.flight || p.hotelDistance || p.nights) && (
        <ul class="mt-5 flex flex-wrap gap-x-5 gap-y-2.5 text-sm text-ink/80">
          {p.flight && (
            <li class="flex items-center gap-2">
              <Icon name="plane" class="h-4 w-4 text-gold" />
              {p.flight}
            </li>
          )}
          {p.hotelDistance && (
            <li class="flex items-center gap-2">
              <Icon name="hotel" class="h-4 w-4 text-gold" />
              {p.hotelDistance}
            </li>
          )}
          {p.nights && (
            <li class="flex items-center gap-2">
              <Icon name="moon" class="h-4 w-4 text-gold" />
              {p.nights} nights
            </li>
          )}
        </ul>
      )
    }

    <div class="mt-auto pt-6">
      <div class="border-t border-line pt-5">
        <p class="text-[11px] font-bold tracking-[0.16em] text-muted uppercase">{p.priceLabel ?? 'Starting from'}</p>
        <p class="mt-1 font-serif text-[34px] leading-tight font-semibold text-brand-900">
          {p.price}
          {hasAmount(p.price) && <span class="font-sans text-sm font-normal text-muted"> / person</span>}
        </p>
        <div class="mt-5 flex gap-3">
          <a href={detail} class="btn btn-navy grow">View details <Icon name="arrow" class="h-4 w-4" /></a>
          {
            wa ? (
              <a
                href={wa}
                target="_blank"
                rel="noopener"
                class="flex h-[50px] w-[50px] shrink-0 items-center justify-center rounded-full bg-wa text-white shadow-soft transition hover:-translate-y-0.5"
                aria-label={`Ask about ${p.name} on WhatsApp`}
              >
                <Icon name="chat" class="h-5 w-5" />
              </a>
            ) : (
              client.phones[0] && (
                <a
                  href={`tel:+91${client.phones[0]}`}
                  class="flex h-[50px] w-[50px] shrink-0 items-center justify-center rounded-full border border-line text-brand-900 transition hover:border-gold"
                  aria-label="Call us"
                >
                  <Icon name="phone" class="h-5 w-5" />
                </a>
              )
            )
          }
        </div>
      </div>
    </div>
  </div>
</article>
