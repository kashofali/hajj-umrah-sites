---
// Repeating Islamic geometric pattern (8-point stars in an interlaced grid).
interface Props {
  class?: string;
  size?: number;
}
const { class: cls = '', size = 96 } = Astro.props;
const id = `pt-${Math.random().toString(36).slice(2, 8)}`;
const h = size / 2;
const s = size * 0.3; // star square half-size
---

<svg class={`pointer-events-none absolute inset-0 h-full w-full ${cls}`} aria-hidden="true">
  <defs>
    <pattern id={id} width={size} height={size} patternUnits="userSpaceOnUse">
      <g fill="none" stroke="currentColor" stroke-width="1">
        <rect x={h - s} y={h - s} width={s * 2} height={s * 2}></rect>
        <rect x={h - s} y={h - s} width={s * 2} height={s * 2} transform={`rotate(45 ${h} ${h})`}></rect>
        <circle cx={h} cy={h} r={s * 0.55}></circle>
        <path d={`M0 0L${h - s * 1.42} ${h - s * 1.42}M${size} 0L${h + s * 1.42} ${h - s * 1.42}M0 ${size}L${h - s * 1.42} ${h + s * 1.42}M${size} ${size}L${h + s * 1.42} ${h + s * 1.42}`}></path>
        <circle cx="0" cy="0" r={s * 0.55}></circle>
        <circle cx={size} cy="0" r={s * 0.55}></circle>
        <circle cx="0" cy={size} r={s * 0.55}></circle>
        <circle cx={size} cy={size} r={s * 0.55}></circle>
      </g>
    </pattern>
  </defs>
  <rect width="100%" height="100%" fill={`url(#${id})`}></rect>
</svg>
