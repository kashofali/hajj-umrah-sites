---
import type { LoadedClient as Client } from '../lib/client';
import SectionHeading from '../components/SectionHeading.astro';

const { client } = Astro.props as { client: Client };
---

<section class="relative overflow-hidden bg-brand-950 py-24 text-white sm:py-28">
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_50%_0%,var(--brand-800),transparent_65%)]"></div>
  <div class="relative mx-auto max-w-[1200px] px-4 sm:px-6">
    <div class="[&_h2]:text-white [&_p:last-child]:text-white/65">
      <SectionHeading eyebrow="How it works" title="Four simple steps to *Labbaik*" />
    </div>
    <ol class="mt-16 grid gap-10 sm:grid-cols-2 lg:grid-cols-4 lg:gap-8">
      {
        client.steps.map((s, i) => (
          <li class="relative">
            {i < client.steps.length - 1 && (
              <span
                class="absolute top-7 left-16 hidden h-px w-[calc(100%-3rem)] bg-gradient-to-r from-gold/60 to-gold/0 lg:block"
                aria-hidden="true"
              />
            )}
            <span class="flex h-14 w-14 items-center justify-center rounded-full border border-gold/50 font-serif text-2xl text-gold-light">
              {i + 1}
            </span>
            <h3 class="mt-6 font-serif text-[26px] leading-tight font-semibold">{s.title}</h3>
            {s.text && <p class="mt-3 leading-relaxed text-white/65">{s.text}</p>}
          </li>
        ))
      }
    </ol>
  </div>
</section>
