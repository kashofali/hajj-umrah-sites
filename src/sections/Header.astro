---
import type { LoadedClient as Client } from '../lib/client';
import { contactHref, isExternal, NAV } from '../lib/client';
import Logo from '../components/Logo.astro';
import Icon from '../components/Icon.astro';

const { client } = Astro.props as { client: Client };
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const book = contactHref(client, `Assalamu Alaikum, I'd like to book an Umrah package.`);
---

<header class="sticky top-0 z-40 border-b border-line/70 bg-bg/90 backdrop-blur-md">
  <div class="mx-auto flex h-20 max-w-[1200px] items-center justify-between gap-6 px-4 sm:px-6">
    <a href="/" class="min-w-0" aria-label={`${client.name}, home`}><Logo client={client} /></a>

    <nav class="hidden items-center gap-8 text-[15px] font-medium lg:flex" aria-label="Main">
      {
        NAV.map((l) => (
          <a
            href={l.href}
            aria-current={isActive(l.href) ? 'page' : undefined}
            class:list={[
              'border-b py-1 transition',
              isActive(l.href) ? 'border-gold text-brand-900' : 'border-transparent text-ink/75 hover:text-brand-900',
            ]}
          >
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={book}
        target={isExternal(book) ? '_blank' : undefined}
        rel="noopener"
        class="btn btn-navy px-5! py-2.5! text-[15px]">Book now</a
      >
      <details class="group relative lg:hidden">
        <summary
          class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-full border border-line text-brand-900 [&::-webkit-details-marker]:hidden"
          aria-label="Menu"
        >
          <Icon name="menu" class="h-5 w-5 group-open:hidden" />
          <Icon name="close" class="hidden h-5 w-5 group-open:block" />
        </summary>
        <nav class="card absolute top-14 right-0 flex w-60 flex-col p-2 shadow-big" aria-label="Mobile">
          {
            NAV.map((l) => (
              <a
                href={l.href}
                aria-current={isActive(l.href) ? 'page' : undefined}
                class:list={['rounded-xl px-4 py-3 font-medium hover:bg-bg', isActive(l.href) ? 'text-gold' : 'text-brand-900']}
              >
                {l.label}
              </a>
            ))
          }
        </nav>
      </details>
    </div>
  </div>
</header>
