---
import type { LoadedClient as Client } from '../lib/client';
import SectionHeading from '../components/SectionHeading.astro';
import Icon from '../components/Icon.astro';

const { client } = Astro.props as { client: Client };
---

<section id="services" class="py-24 sm:py-28">
  <div class="mx-auto max-w-[1200px] px-4 sm:px-6">
    <SectionHeading
      eyebrow="What we do"
      title="One trusted desk for all your *travel*"
      sub={`Umrah, Hajj, visas and tickets, all handled by one team in ${client.city}.`}
    />
    <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        client.services!.map((s, i) => (
          <div class="card relative p-8 transition duration-300 hover:-translate-y-1 hover:shadow-soft">
            <span class="absolute top-6 right-7 font-serif text-[44px] leading-none text-gold-pale">
              {String(i + 1).padStart(2, '0')}
            </span>
            <span class="flex h-14 w-14 items-center justify-center rounded-2xl bg-brand-900 text-gold-light shadow-soft">
              <Icon name={s.icon ?? 'check'} class="h-6 w-6" />
            </span>
            <h3 class="mt-7 font-serif text-[26px] leading-tight font-semibold text-brand-900">{s.title}</h3>
            {s.text && <p class="mt-3 leading-relaxed text-muted">{s.text}</p>}
          </div>
        ))
      }
    </div>
  </div>
</section>
